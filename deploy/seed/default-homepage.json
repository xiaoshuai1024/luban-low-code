  "seo": {
    "title": "Luban 鲁班 — 开源低代码平台",
    "description": "拖拽式可视化低代码平台：75+ Material Design 组件、连接任意数据库、SSR 服务端渲染、AI 智能生成页面。Vue 3 + Spring Boot 全栈开源。",
    "keywords": ["低代码", "低代码平台", "开源", "可视化搭建", "拖拽建站", "Vue 3", "Spring Boot", "低代码引擎"],
