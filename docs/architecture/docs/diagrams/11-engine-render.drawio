        <mxCell id="rt0" value="ErrorBoundary 包裹（单物料崩溃不致整页空白）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="320" y="125" width="520" height="24" as="geometry"/></mxCell>

        <!-- 决策菱形 -->
        <mxCell id="rt_vis" value="visible&#10;求值？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="340" y="160" width="90" height="70" as="geometry"/></mxCell>
        <mxCell id="rt_loop" value="loop？&#10;数组循环" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="470" y="160" width="90" height="70" as="geometry"/></mxCell>
