        <!-- ===== AI 服务 ===== -->
        <mxCell id="g_ai" value="③ luban-ai-assistant :8100（FastAPI）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="780" height="560" as="geometry"/></mxCell>

        <!-- API 层 -->
        <mxCell id="api" value="API 层（app/api）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="115" width="740" height="34" as="geometry"/></mxCell>
        <mxCell id="api1" value="POST /ai/chat&#10;(SSE 流式)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5e9fa;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="600" y="155" width="120" height="40" as="geometry"/></mxCell>
        <mxCell id="api2" value="WS /ai/agent&#10;(15s 心跳)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5e9fa;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="725" y="155" width="115" height="40" as="geometry"/></mxCell>
        <mxCell id="api3" value="POST /ai/generate&#10;(单轮生成)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5e9fa;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="845" y="155" width="120" height="40" as="geometry"/></mxCell>
