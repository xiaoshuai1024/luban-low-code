        <!-- Guardrail -->
        <mxCell id="guard" value="🛡️ Guardrails：输入 injection 检测 + PII 脱敏（手机/邮箱/身份证/银行卡 → 占位）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1"><mxGeometry x="600" y="205" width="740" height="32" as="geometry"/></mxCell>

        <!-- Agent Runner -->
