        <mxCell id="title" value="luban AI 助手 · 总体架构（一句话 → 合法低代码页面）" style="text;html=1;align=center;fontSize=18;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1"><mxGeometry x="300" y="15" width="800" height="34" as="geometry"/></mxCell>

        <!-- ===== 前端 ===== -->
        <mxCell id="g_fe" value="① 前端 · engine 设计器 AiAssistantPanel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="200" as="geometry"/></mxCell>
        <mxCell id="fe1" value="💬 消息流（用户输入 + AI 回复）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="fe2" value="📊 agent 进度条（流式 progress 事件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="168" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="fe3" value="✋ HITL 确认（确认/拒绝落画布）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="216" width="220" height="40" as="geometry"/></mxCell>

        <!-- ===== BFF 反代 ===== -->
