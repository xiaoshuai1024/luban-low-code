        <mxCell id="bff1" value="解析 JWT / Visitor&#10;读用户身份" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="120" width="160" height="44" as="geometry"/></mxCell>
        <mxCell id="bff2" value="附 X-Internal-Token&#10;+ X-User-Id/Role" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=10;" vertex="1" parent="1"><mxGeometry x="360" y="172" width="160" height="44" as="geometry"/></mxCell>
