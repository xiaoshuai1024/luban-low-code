        <mxCell id="b_vis" value="false → 不渲染" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="335" y="255" width="100" height="28" as="geometry"/></mxCell>
        <mxCell id="b_loop" value="按 item 重复&#10;注入 ctx" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="465" y="255" width="100" height="36" as="geometry"/></mxCell>
        <mxCell id="b_form" value="v-model 绑 formState&#10;实时校验→formErrors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="585" y="255" width="130" height="36" as="geometry"/></mxCell>
        <mxCell id="b_normal" value="普通组件渲染&#10;props(含插值)+events+style&#10;+ 子节点/slot 递归" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#2d6a2d;fontColor=#fff;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="240" height="50" as="geometry"/></mxCell>
        <mxCell id="b_unknown" value="未知类型 → 仅渲染 children" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999;fontSize=9;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="230" height="28" as="geometry"/></mxCell>

        <!-- CMS 解析 -->
        <mxCell id="b_cms" value="CMS 绑定：host 预拉 collection items → 按 nodeId 注入 props（绑定优先于静态）→ provide('lb-cms-resolved')" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#10739e;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="395" width="520" height="36" as="geometry"/></mxCell>
        <!-- 响应式/动画 -->
        <mxCell id="b_resp" value="响应式：挂 data-lb-node，treeResponsiveCss 产出三断点 @media（website 按 SSR 视口应用）；无字段则零开销不输出 CSS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#cdebcd;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="440" width="520" height="36" as="geometry"/></mxCell>
        <!-- 表达式上下文 -->
        <mxCell id="b_ctx" value="表达式上下文 evalCtx = { ...ctx(数据源), $form(表单值) }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;" vertex="1" parent="1"><mxGeometry x="320" y="485" width="520" height="30" as="geometry"/></mxCell>

        <!-- 沙箱 -->
        <mxCell id="g_sandbox" value="🔒 自研表达式沙箱（expression.ts）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;verticalAlign=top;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="90" width="440" height="450" as="geometry"/></mxCell>
        <mxCell id="s1" value="递归下降 Parser → AST" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="130" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="s2" value="Executor 只识别白名单 AST 节点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="940" y="168" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="s3" value="支持：字面量 / 标识符 / 成员索引 / 一元 / 算术 / 比较 / 逻辑 / 三元" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="940" y="206" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="s4" value="API：evaluate() / interpolate({{}}) / evaluateBoolean()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="940" y="244" width="400" height="30" as="geometry"/></mxCell>

        <mxCell id="s_black" value="🚫 严格黑名单（安全 MUST）" style="text;html=1;fontSize=10;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1"><mxGeometry x="940" y="285" width="200" height="20" as="geometry"/></mxCell>
        <mxCell id="s5" value="禁 eval / Function / new / this / import" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7a1f1c;fontColor=#fff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="940" y="310" width="195" height="30" as="geometry"/></mxCell>
        <mxCell id="s6" value="禁任意函数调用（防调构造器）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7a1f1c;fontColor=#fff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1145" y="310" width="195" height="30" as="geometry"/></mxCell>
        <mxCell id="s7" value="标识符仅从 ctx 取值（无 ctx → undefined，绝不 fallback 全局）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7a1f1c;fontColor=#fff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="940" y="348" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="s8" value="成员访问黑名单：constructor / __proto__ / prototype" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b85450;strokeColor=#7a1f1c;fontColor=#fff;fontSize=9;" vertex="1" parent="1"><mxGeometry x="940" y="386" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="s9" value="🔗 AI 侧 expression_validator.py 黑名单与本文件逐字对齐" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="424" width="400" height="30" as="geometry"/></mxCell>
        <mxCell id="s10" value="异常安全：evaluateBoolean 异常默认 false（更安全）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=9;" vertex="1" parent="1"><mxGeometry x="940" y="462" width="400" height="30" as="geometry"/></mxCell>

