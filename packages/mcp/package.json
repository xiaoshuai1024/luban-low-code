{
  "name": "@luban-low-code/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "Luban MCP Server — exposes low-code platform capabilities via Model Context Protocol. 通过 MCP 协议向 AI 客户端暴露 Luban 低代码平台的完整管理能力。",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build",
    "publish:npm": "node scripts/publish.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "luban",
    "low-code",
    "mcp",
    "model-context-protocol",
    "claude",
    "cms",
    "ai"
  ],
  "homepage": "https://github.com/luban-platform/luban-workspace/tree/main/packages/mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luban-platform/luban-workspace.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/luban-platform/luban-workspace/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.6.3",
    "vitest": "^4.1.10"
  }
}
