        <!-- 状态图节点 -->
        <mxCell id="n1" value="① understand&#10;意图分类" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="600" y="295" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="n2" value="② tool_call&#10;读现有 schema/线索" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="722" y="295" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="n3" value="③ retrieve&#10;RAG 召回物料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="844" y="295" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="n4" value="④ generate&#10;LLM 生成 schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="966" y="295" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="n5" value="⑤ validate&#10;六重校验闸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#82b366;strokeColor=#2d6a2d;fontColor=#fff;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1088" y="295" width="110" height="50" as="geometry"/></mxCell>
        <mxCell id="n6" value="⑥ hitl&#10;awaiting_confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1210" y="295" width="110" height="50" as="geometry"/></mxCell>

        <!-- 回环标注 -->
        <mxCell id="loop_lbl" value="↻ 校验失败 → feedback 节点把错误反馈给 generate 重试（≤ max_retries=3），自我修正不无限循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="600" y="355" width="600" height="28" as="geometry"/></mxCell>

        <!-- 校验闸明细 -->
        <mxCell id="val_box" value="✅ 六重校验闸（schemas/validators.py）：结构(Pydantic) · 物料存在 · propsSchema(jsonschema) · 表达式沙箱对齐 · 循环引用 · ID 唯一" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#2d6a2d;fontSize=9;" vertex="1" parent="1"><mxGeometry x="600" y="392" width="740" height="30" as="geometry"/></mxCell>

        <!-- 工具回环 -->
        <mxCell id="tool_box" value="🔄 ToolClient（httpx 回环 BFF）：get_page_schema / list_leads · 带 X-Internal-Token · visitor 禁用 · tenacity 重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=9;" vertex="1" parent="1"><mxGeometry x="600" y="428" width="740" height="30" as="geometry"/></mxCell>

        <!-- LLM + RAG -->
        <mxCell id="llm_box" value="🧠 LLM Provider（LiteLLM）&#10;DeepSeek(首选) / GLM / Qwen&#10;运行期单一可切 · 结构化输出(response_format+重试)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="600" y="468" width="360" height="56" as="geometry"/></mxCell>
        <mxCell id="rag_box" value="📚 RAG（app/rag）&#10;Qdrant hybrid: dense+sparse+RRF&#10;61 物料 → embed → 检索 top-k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4ace4;strokeColor=#9673a6;fontSize=9;" vertex="1" parent="1"><mxGeometry x="980" y="468" width="360" height="56" as="geometry"/></mxCell>

