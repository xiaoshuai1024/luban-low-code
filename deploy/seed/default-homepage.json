            { "icon": "🦸", "title": "Hero 主视觉" },
            { "icon": "🎯", "title": "CTA 行动号召" },
            { "icon": "📊", "title": "Stats 数据统计" },
            { "icon": "📋", "title": "Table 表格" },
            { "icon": "📝", "title": "Form 表单" },
            { "icon": "✏️", "title": "Input 输入框" },
            { "icon": "✅", "title": "Select 选择器" },
            { "icon": "☑️", "title": "Checkbox 复选框" },
            { "icon": "🔄", "title": "Switch 开关" },
            { "icon": "⬜", "title": "Button 按钮" },
            { "icon": "📄", "title": "Card 卡片" },
            { "icon": "🖼", "title": "Image 图片" },
            { "icon": "🔗", "title": "Link 链接" },
            { "icon": "📑", "title": "Tabs 标签页" },
            { "icon": "📐", "title": "Row/Col 栅格" },
            { "icon": "🧩", "title": "Container 容器" },
            { "icon": "🔔", "title": "Modal 弹窗" },
            { "icon": "📌", "title": "Drawer 抽屉" },
            { "icon": "💬", "title": "Toast 轻提示" },
            { "icon": "⚠️", "title": "Alert 警告条" },
            { "icon": "❓", "title": "FAQ 常见问题" },
            { "icon": "⭐", "title": "Rating 评分" },
            { "icon": "🔄", "title": "Carousel 轮播" },
            { "icon": "📈", "title": "Gallery 图库" },
            { "icon": "💳", "title": "Pricing 定价" },
            { "icon": "📝", "title": "Markdown" },
            { "icon": "💻", "title": "CodeBlock 代码块" },
            { "icon": "🪜", "title": "Steps 步骤条" },
            { "icon": "⬆️", "title": "BackToTop 回顶" }
          ]
        }
      },
      {
        "id": "cta",
        "type": "LubanCTA",
        "animation": { "type": "slide-up", "trigger": "in-view", "duration": 600, "easing": "cubic-bezier(0.22,1,0.36,1)" },
        "props": {
          "heading": "准备开始了吗？",
          "description": "进入控制台，2 分钟搭建你的第一个页面。",
          "buttonText": "进入控制台",
          "buttonUrl": "https://manage.xiaoshuai1024.top",
          "secondaryButtonText": "GitHub 仓库",
          "secondaryButtonUrl": "https://github.com/xiaoshuai1024/luban-low-code",
          "backgroundColor": "#0f172a",
          "textColor": "#ffffff"
        }
      },
      {
        "id": "footer",
        "type": "LubanFooter",
        "animation": { "type": "fade", "trigger": "in-view", "duration": 600 },
        "props": {
          "backgroundColor": "#0f172a",
          "textColor": "#ffffff",
          "columns": [
            {
              "title": "产品",
              "links": [
                { "label": "核心特性", "url": "#features" },
                { "label": "组件库", "url": "#components" },
                { "label": "控制台", "url": "https://manage.xiaoshuai1024.top" }
              ]
            },
            {
              "title": "资源",
              "links": [
                { "label": "GitHub 仓库", "url": "https://github.com/xiaoshuai1024/luban-low-code" },
                { "label": "Issue 反馈", "url": "https://github.com/xiaoshuai1024/luban-low-code/issues" }
              ]
            }
          ],
          "copyright": "© 2026 Luban · 基于 Vue 3 + Spring Boot 构建 · MIT 开源协议"
        }
      }
    ]
