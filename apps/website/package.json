{
  "name": "luban-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "dev:landing": "npx serve .output/public -p 3000",
    "build:landing": "node -e \"var f=require('fs');['app/router.options.ts','router/routes.ts','views/Home.vue'].forEach(function(p){var s='app/'+p;if(f.existsSync(p)){f.renameSync(p,p+'.bak');console.log('moved',p)}});process.on('exit',function(){['app/router.options.ts','router/routes.ts','views/Home.vue'].forEach(function(p){var s='app/'+p;if(!f.existsSync(p)&&f.existsSync(p+'.bak')){f.renameSync(p+'.bak',p);console.log('restored',p)}})})\" && nuxt generate && npx serve .output/public -p 3000",
    "install:e2e": "playwright install chrome",
    "install:e2e:ci": "playwright install chromium",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "LUBAN_E2E_USE_PLAYWRIGHT_CHROMIUM=1 playwright test"
  },
  "dependencies": {
    "@pinia/nuxt": "^0.5.4",
    "@luban-low-code/luban-base": "link:../../packages/ui/packages/luban-base",
    "@luban-low-code/luban-low-code": "link:../../packages/ui/packages/luban-low-code",
    "nuxt": "^3.14.0",
    "pinia": "^2.2.6",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "typescript": "^5.6.3"
  }
}
