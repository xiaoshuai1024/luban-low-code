# =====================================================================
# luban local dev stack — copy to .env before `docker compose up`.
# All values below are DEV-ONLY placeholders. Do NOT reuse in production.
# 端口 / 主机地址 / 服务互访 URL 均在 docker-compose.yml 中定义，此处不放。
# =====================================================================

# ---- MySQL -------------------------------------------------------------
MYSQL_ROOT_PASSWORD=luban_root_dev
MYSQL_DATABASE=luban
MYSQL_USER=luban
MYSQL_PASSWORD=luban_dev_pass

# ---- Shared secrets (backend + bff MUST share the same values) ---------
# LEAD_ENC_KEY: 32-byte AES-256 key, base64-encoded. Regenerate with:
#   openssl rand -base64 32
LEAD_ENC_KEY=UqmejJTJSLBO3J4HkL1bbkxfgDqhl6aYYUOlF/ZjaeI=

# AUTH_JWT_SECRET: random hex; used by both backend and bff. Regenerate with:
#   openssl rand -hex 32
AUTH_JWT_SECRET=8970a0801fe51cef1702f2dafc320e2c12e9dc4639af0d49704233b3ac9744b9

# INTERNAL_AUTH_SECRET: BFF→backend 内部共享密钥（X-Internal-Auth 头）。
# backend 未配置时 fail-open（仅限本地 dev）；生产 compose（backend+bff）用
# ${INTERNAL_AUTH_SECRET:?} 强制要求 .env.prod 提供该值（勿入仓）。
#   openssl rand -hex 32
INTERNAL_AUTH_SECRET=

# ---- SMTP（注册验证码发信）----------------------------------------------
# 生产从 .env.prod 注入（docker-compose.prod.yml backend 透传至 Spring mail.*），禁入仓。
# SMTP_HOST 留空时 MailService fail-closed：发码返回 503 EMAIL_SERVICE_UNAVAILABLE。
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=
# SMTP_FROM=noreply@example.com

# ---- SSH（push-based 远程部署：deploy-prod.sh 读取，本地 docker compose up 不需要）-
# deploy-prod.sh 通过 SSH 免密 key 连到远端服务器：本地打包 → scp → 远端 build+up。
# 生产部署请填到 .env.prod，勿提交真实值。
SSH_HOST=
SSH_USER=
# SSH 认证走免密 key（推荐），不再支持明文口令
# SSH_PASS=
# 远端工作目录（可选，留空走默认）
# REMOTE_DIR=/opt/luban/prod/luban-low-code
