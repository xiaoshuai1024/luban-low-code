{
  "root": {
    "id": "page",
    "type": "LubanContainer",
    "props": { "maxWidth": "full", "padded": false },
    "children": [
      {
        "id": "navbar",
        "type": "LubanNavbar",
        "props": {
          "brand": "Luban 鲁班",
          "sticky": true,
          "backgroundColor": "#ffffff",
          "textColor": "#1e293b",
          "links": [
            { "label": "特性", "url": "#features" },
            { "label": "组件", "url": "#components" },
            { "label": "控制台", "url": "https://manage.xiaoshuai1024.top" },
            { "label": "GitHub", "url": "https://github.com/xiaoshuai1024/luban-low-code" }
          ]
        }
      },
      {
        "id": "hero",
        "type": "LubanHero",
        "props": {
          "eyebrow": "开源 · MIT 协议",
          "title": "像搭积木一样，构建你的应用",
          "subtitle": "拖拽式可视化低代码平台：75+ Material Design 组件、连接任意数据库、随处部署。Vue 3 + Spring Boot 全栈开源。",
          "ctaText": "开始使用",
          "ctaUrl": "https://manage.xiaoshuai1024.top",
          "secondaryCtaText": "GitHub 仓库",
          "secondaryCtaUrl": "https://github.com/xiaoshuai1024/luban-low-code",
          "backgroundColor": "#ffffff",
          "textColor": "#1e293b",
          "height": "560px",
          "align": "center",
          "layout": "centered"
        }
      },
      {
        "id": "stats",
        "type": "LubanStats",
        "animation": { "type": "slide-up", "trigger": "in-view", "duration": 600, "easing": "cubic-bezier(0.22,1,0.36,1)" },
        "props": {
          "backgroundColor": "#f8fafc",
          "textColor": "#1e293b",
          "stats": [
            { "value": "75", "suffix": "+", "label": "开箱即用组件", "icon": "🧩" },
            { "value": "Vue 3", "label": "现代前端框架", "icon": "⚡" },
            { "value": "MIT", "label": "开源协议", "icon": "🔓" },
            { "value": "SSR", "label": "服务端渲染", "icon": "🚀" }
          ]
        }
      },
      {
        "id": "features",
        "type": "LubanFeatureGrid",
        "animation": { "type": "slide-up", "trigger": "in-view", "duration": 600, "easing": "cubic-bezier(0.22,1,0.36,1)" },
        "props": {
          "heading": "核心特性",
          "columns": 3,
          "backgroundColor": "#ffffff",
          "features": [
            { "icon": "🎨", "title": "可视化搭建", "description": "拖拽即所得的设计器，实时预览，无需编码即可完成页面布局。" },
            { "icon": "📚", "title": "75+ 组件", "description": "按钮、表单、表格、图表一应俱全的 Material Design 组件库。" },
            { "icon": "⚡", "title": "SSR 就绪", "description": "Nuxt Nitro 服务端渲染，SEO 友好，首屏秒开。" },
            { "icon": "🤖", "title": "AI 智能生成", "description": "用自然语言描述页面，AI 自动生成页面 Schema。" },
            { "icon": "📊", "title": "数据驱动", "description": "可视化查询构建器，连接 MySQL、PostgreSQL 或 REST API。" },
            { "icon": "🌐", "title": "多端适配", "description": "一次搭建，桌面、平板、手机全尺寸响应式渲染。" }
          ]
        }
      },
      {
        "id": "components",
        "type": "LubanFeatureGrid",
        "animation": { "type": "zoom", "trigger": "in-view", "duration": 700, "easing": "cubic-bezier(0.22,1,0.36,1)" },
        "props": {
          "heading": "75+ 开箱即用的物料组件",
          "columns": 4,
          "backgroundColor": "#f8fafc",
