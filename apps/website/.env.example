# luban-website E2E 环境变量样例
# 复制为 .env（nuxt dev 与 playwright 均读取）

# BFF 地址（website 通过它拉取公开页 schema）
NUXT_PUBLIC_BFF_BASE_URL=http://127.0.0.1:3100
NUXT_PUBLIC_DEFAULT_SITE_SLUG=default

# Playwright baseURL（默认同 nuxt dev 端口）
# LUBAN_E2E_BASE_URL=http://127.0.0.1:3000

# CI 无系统 Chrome 时回退
# LUBAN_E2E_USE_PLAYWRIGHT_CHROMIUM=1
